<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net10.0</TargetFrameworks>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <Title>HelixForge</Title>
    <Authors>TekLot,$(AssemblyName)</Authors>
    <Description>HelixForge provides a unified abstraction layer over hardware devices with a simulation backend and built-in telemetry. Write once, run on real or simulated hardware.</Description>
    <Copyright>Copyright © 2026 TekLot</Copyright>
    <PackageId>HelixForge</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageTags>HelixForge;HardwareAbstraction;Simulation;Robotics;UAV;Telemetry;dotnet-library</PackageTags>
    <PackageReleaseNotes>Unified device abstraction layer: typed sensor and actuator interfaces, zero-allocation ImuData/GpsData/Vector3 value types, and a type-safe DeviceRegistry.</PackageReleaseNotes>
    <PackageProjectUrl>https://github.com/teklot/HelixForge</PackageProjectUrl>
    <RepositoryUrl>https://github.com/teklot/HelixForge.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

</Project>
