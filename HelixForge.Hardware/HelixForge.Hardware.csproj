<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <Title>HelixForge.Hardware</Title>
    <Authors>TekLot,$(AssemblyName)</Authors>
    <Description>Real hardware device drivers for HelixForge. SPI/I2C/UART/PWM drivers for IMU, GPS, and motor ESC hardware.</Description>
    <Copyright>Copyright © 2026 TekLot</Copyright>
    <PackageId>HelixForge.Hardware</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageTags>HelixForge;Hardware;Robotics;UAV;IMU;GPS;PWM;I2C;SPI;dotnet-library</PackageTags>
    <PackageReleaseNotes>Real hardware drivers: BMI160 IMU over I2C with full accelerometer/gyroscope burst reads and monotonic timestamps, NMEA 0183 GPS over UART, and PWM motor ESC control.</PackageReleaseNotes>
    <PackageProjectUrl>https://github.com/teklot/HelixForge</PackageProjectUrl>
    <RepositoryUrl>https://github.com/teklot/HelixForge.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Device.Gpio" />
    <PackageReference Include="System.IO.Ports" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HelixForge\HelixForge.csproj" />
  </ItemGroup>

</Project>
