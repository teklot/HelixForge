<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <Title>HelixForge.Hardware</Title>
    <Authors>TekLot,$(AssemblyName)</Authors>
    <Description>Real hardware device drivers for HelixForge. SPI/I2C/UART/PWM drivers for IMU, GPS, and motor ESC hardware.</Description>
    <Copyright>Copyright © 2026 TekLot</Copyright>
    <PackageId>HelixForge.Hardware</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageTags>HelixForge;Hardware;Robotics;UAV;IMU;GPS;PWM;I2C;SPI;dotnet-library</PackageTags>
    <PackageReleaseNotes>
	  - Transport seams (II2cBus, ISpiBus, ISerialTransport, IPwmChannel, IDShotTransport) with System.Device adapters for hardware-free unit tests
      - BMI160 IMU over SPI (SPI-mode activation and read-bit protocol)
      - UBX NAV-PVT GPS parsing with Fletcher-8 validation and NED-to-local velocity mapping
      - DShot frame/CRC codec and DShotMotorDevice over an IDShotTransport seam
      - BMI160, NMEA, and PWM drivers refactored onto transports with full test coverage
    </PackageReleaseNotes>
    <PackageProjectUrl>https://github.com/teklot/HelixForge</PackageProjectUrl>
    <RepositoryUrl>https://github.com/teklot/HelixForge.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Device.Gpio" />
    <PackageReference Include="System.IO.Ports" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HelixForge\HelixForge.csproj" />
  </ItemGroup>

</Project>
