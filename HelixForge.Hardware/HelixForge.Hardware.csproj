<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <Title>HelixForge.Hardware</Title>
    <Authors>TekLot,$(AssemblyName)</Authors>
    <Description>Real hardware device drivers for HelixForge. SPI/I2C/UART/PWM drivers for IMU, GPS, and motor ESC hardware.</Description>
    <Copyright>Copyright © 2026 TekLot</Copyright>
    <PackageId>HelixForge.Hardware</PackageId>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageTags>HelixForge;Hardware;Robotics;UAV;IMU;GPS;PWM;I2C;SPI;dotnet-library</PackageTags>
    <PackageReleaseNotes>
      - NMEA GPS parsing now reports the actual fix quality and derives north/east velocity from speed and course over ground
      - PWM motors now disarm and stop the channel when disposed, and resetting after disposal is safe
      - DShot motors can be reset after disposal without sending a frame
    </PackageReleaseNotes>
    <PackageProjectUrl>https://github.com/teklot/HelixForge</PackageProjectUrl>
    <RepositoryUrl>https://github.com/teklot/HelixForge.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Device.Gpio" />
    <PackageReference Include="System.IO.Ports" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HelixForge\HelixForge.csproj" />
  </ItemGroup>

</Project>
